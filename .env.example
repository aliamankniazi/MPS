# Variable NAMES only. Real values live in .env.local on this PC (git-ignored)
# and in the Vercel project's Environment Variables. Never commit a value.

# --- Database (required) -----------------------------------------------------
# This PC: the local database from docker-compose.dev.yml, e.g.
#   mysql://root:<MPS_DEV_DB_PASSWORD>@127.0.0.1:3406/mps
# Vercel: the TiDB Cloud address. NEVER put the cloud address in .env.local.
DATABASE_URL=
# (Alternatively the TiDB Cloud Vercel integration sets TIDB_HOST, TIDB_PORT,
#  TIDB_USER, TIDB_PASSWORD and TIDB_DATABASE, and DATABASE_URL can be left out.)

# --- Email (required on Vercel) ----------------------------------------------
# Sends the "approve your sign-in" and "reset your password" links.
# Without SMTP_URL on this PC, the link is printed in the server console.
SMTP_URL=
MAIL_FROM=

# --- Optional ----------------------------------------------------------------
# The address people use, for links in emails. Defaults to the request's own address.
APP_URL=
# Integration tests only: must be on this PC and end in _e2e_test.
TEST_DATABASE_URL=
# Data export only: path of the Firebase service-account key, kept OUTSIDE this folder.
GOOGLE_APPLICATION_CREDENTIALS=
