{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "next-env.d.ts",
    "src/server/**/*.ts",
    "src/data/**/*.ts",
    "src/firebase/**/*.ts",
    "src/firebase/**/*.tsx",
